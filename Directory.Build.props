<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'ExcelRenderer.Tests' And '$(MSBuildProjectName)' != 'ExcelRenderer.Tool.Tests'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SA1101;SA1200;SA1309;SA1629;SA1633</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'ExcelRenderer.Tests' And '$(MSBuildProjectName)' != 'ExcelRenderer.Tool.Tests'">
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
