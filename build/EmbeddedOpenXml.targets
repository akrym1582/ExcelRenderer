<Project>
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeOpenXmlBuildOutput</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <!-- PrivateAssets hides the source project dependency. Export its runtime
         package dependency explicitly; DocumentFormat.OpenXml is already direct. -->
    <PackageReference Include="ExcelNumberFormat" Version="1.1.0" />
  </ItemGroup>
  <Target Name="IncludeOpenXmlBuildOutput" DependsOnTargets="ResolveReferences">
    <!-- Required runtime assemblies must also be included when no-build packing
         leaves ReferenceCopyLocalPaths incomplete. Verify the built outputs. -->
    <ItemGroup>
      <_RequiredEmbeddedOpenXmlOutput Include="$(TargetDir)ExcelRenderer.OpenXml.Reader.dll;$(TargetDir)ExcelRenderer.OpenXml.Reader.xml" />
      <_RequiredEmbeddedOpenXmlOutput Include="$(TargetDir)ExcelRenderer.OpenXml.dll;$(TargetDir)ExcelRenderer.OpenXml.xml" />
      <_RequiredEmbeddedOpenXmlOutput Include="$(TargetDir)ExcelRenderer.Formulas.dll;$(TargetDir)ExcelRenderer.Formulas.xml" />
    </ItemGroup>
    <Error Condition="!Exists('%(_RequiredEmbeddedOpenXmlOutput.Identity)')" Text="Required embedded package output is missing: %(_RequiredEmbeddedOpenXmlOutput.Identity). Build $(MSBuildProjectName) before packing." />
    <ItemGroup>
      <BuildOutputInPackage Include="@(_RequiredEmbeddedOpenXmlOutput)" />
    </ItemGroup>
  </Target>
</Project>
