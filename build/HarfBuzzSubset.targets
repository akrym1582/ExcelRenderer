<Project>
  <PropertyGroup>
    <ExcelRendererNativeRoot>$(MSBuildThisFileDirectory)../native/runtimes</ExcelRendererNativeRoot>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(ExcelRendererNativeRoot)/**/*" Exclude="$(ExcelRendererNativeRoot)/**/*.json" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
    <None Include="$(ExcelRendererNativeRoot)/$(NETCoreSdkRuntimeIdentifier)/native/*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" Visible="false" />
  </ItemGroup>
  <Target Name="VerifyHarfBuzzSubsetHostAsset" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_ExcelRendererSubsetHostAsset Include="$(ExcelRendererNativeRoot)/$(NETCoreSdkRuntimeIdentifier)/native/*" />
    </ItemGroup>
    <Error Condition="'@(_ExcelRendererSubsetHostAsset)' == ''" Text="Build the native Skia PDF subset adapter before packing: python scripts/build-harfbuzz-subset.py" />
  </Target>
</Project>
