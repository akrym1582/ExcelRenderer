%!PS-Adobe-3.0
%%Creator: ExcelRenderer
%%LanguageLevel: 3
% Requires Type 42 and PostScript 3011+ large sfnt table support.
%%DocumentData: Clean7Bit
%%Pages: (atend)
%%BoundingBox: (atend)
%%DocumentSuppliedResources: (atend)
%%EndComments
%%BeginProlog
/ERDict 20 dict def ERDict begin
/rectpath {4 dict begin /h exch def /w exch def /y exch def /x exch def x y moveto w 0 rlineto 0 h rlineto w neg 0 rlineto closepath end} bind def
%%EndProlog
%%Page: 1 1
%%PageBoundingBox: 0 0 80 80
%%BeginPageSetup
<< /PageSize [80 80] >> setpagedevice
gsave 0 80 translate 1 -1 scale
%%EndPageSetup
0 0 0 setrgbcolor
0.75 setlinewidth [] 0 setdash
newpath 40.75 10 moveto 40.75 40 lineto stroke
newpath 39.25 10 moveto 39.25 40 lineto stroke
grestore showpage
%%PageTrailer
end
%%Trailer
%%Pages: 1
%%BoundingBox: 0 0 80 80
%%DocumentSuppliedResources: none
%%EOF
