<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ExcelRenderer.Core</AssemblyName>
    <RootNamespace>ExcelRenderer.Core</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer.OpenXml.Reader/ExcelRenderer.OpenXml.Reader.csproj" />
  </ItemGroup>
</Project>
