<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>1.10.3</Version>
    <PackageId>ExcelRenderer.Mapping</PackageId>
    <Description>Map C# objects and JSON into Excel templates with nested row arrays.</Description>
    <Authors>akrym1582</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
    <None Include="../../docs/mapping.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer.OpenXml/ExcelRenderer.OpenXml.csproj" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="../../build/EmbeddedOpenXml.targets" />
  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer.OpenXml.Reader/ExcelRenderer.OpenXml.Reader.csproj" PrivateAssets="all" />
    <ProjectReference Include="../ExcelRenderer.Formulas/ExcelRenderer.Formulas.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
