<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Version>1.8.0</Version>
    <PackageId>ExcelRenderer.OpenXml</PackageId>
    <Description>XLSX editing, writing and formula recalculation adapter.</Description>
    <Authors>akrym1582</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/akrym1582/ExcelRenderer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/openxml-integration.md" Pack="true" PackagePath="/README.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer.OpenXml.Reader/ExcelRenderer.OpenXml.Reader.csproj" />
    <ProjectReference Include="../ExcelRenderer.Formulas/ExcelRenderer.Formulas.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>
</Project>
