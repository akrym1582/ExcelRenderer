<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>excelrenderer</ToolCommandName>
    <PackageId>ExcelRenderer.Tool</PackageId>
    <Version>1.0.0</Version>
    <Title>ExcelRenderer command-line tool</Title>
    <Description>Convert Excel XLSX files to PDF, PNG and AI-friendly Markdown.</Description>
    <Authors>akrym1582</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/akrym1582/ExcelRenderer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>excel xlsx pdf png markdown cli dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer/ExcelRenderer.csproj" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>
</Project>
