<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>excelrenderer</ToolCommandName>
    <PackageId>ExcelRenderer.Tool</PackageId>
    <Version>1.10.0</Version>
    <Title>ExcelRenderer command-line tool</Title>
    <Description>Convert Excel XLSX files to PDF, PNG and AI-friendly Markdown.</Description>
    <Authors>akrym1582</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/akrym1582/ExcelRenderer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>excel xlsx pdf png markdown cli dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../native/harfbuzz/COPYING" Pack="true" PackagePath="licenses/HarfBuzz-COPYING" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../native/runtimes/win-x64/native/*" Condition="'$(NETCoreSdkRuntimeIdentifier)' != 'win-x64'" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../native/runtimes/linux-x64/native/*" Condition="'$(NETCoreSdkRuntimeIdentifier)' != 'linux-x64'" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer.OpenXml/ExcelRenderer.OpenXml.csproj" />
    <ProjectReference Include="../ExcelRenderer/ExcelRenderer.csproj" />
    <ProjectReference Include="../ExcelRenderer.Mapping/ExcelRenderer.Mapping.csproj" />
    <ProjectReference Include="../ExcelRenderer.Fonts/ExcelRenderer.Fonts.csproj" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>
</Project>
