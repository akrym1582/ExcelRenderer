<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>excelrenderer</ToolCommandName>
    <PackageId>ExcelRenderer.Tool</PackageId>
    <Version>1.11.0</Version>
    <Title>ExcelRenderer command-line tool</Title>
    <Description>Convert Excel XLSX files to PDF, PostScript, PNG and SVG.</Description>
    <Authors>akrym1582</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/akrym1582/ExcelRenderer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>excel xlsx pdf postscript png cli dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/nuget/ExcelRenderer.Tool.md" Pack="true" PackagePath="/README.md" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer.OpenXml/ExcelRenderer.OpenXml.csproj" />
    <ProjectReference Include="../ExcelRenderer/ExcelRenderer.csproj" />
    <ProjectReference Include="../ExcelRenderer.Core/ExcelRenderer.Core.csproj" />
    <ProjectReference Include="../ExcelRenderer.Mapping/ExcelRenderer.Mapping.csproj" />
    <ProjectReference Include="../ExcelRenderer.Fonts/ExcelRenderer.Fonts.csproj" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.0" />
  </ItemGroup>
</Project>
