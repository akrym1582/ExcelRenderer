<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Version>1.5.1</Version>
    <PackageId>ExcelRenderer</PackageId>
    <Title>ExcelRenderer</Title>
    <Description>Render Excel XLSX files to PDF, PNG, SVG and AI-friendly Markdown.</Description>
    <Authors>akrym1582</Authors>
    <PackageTags>excel xlsx pdf png svg markdown closedxml pdfsharp skia</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/akrym1582/ExcelRenderer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

  </PropertyGroup>
  
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../third_party/NotoSansJP/OFL.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../third_party/IPAmjMincho/IPA_Font_License_Agreement_v1.0.txt" Pack="true" PackagePath="licenses/IPAmjMincho/" />
    <None Include="../../third_party/IPAmjMincho/Readme.txt" Pack="true" PackagePath="licenses/IPAmjMincho/" />
    <EmbeddedResource Include="../../third_party/NotoSansJP/NotoSansCJKjp-Regular.otf" LogicalName="ExcelRenderer.NotoSansCJKjp-Regular.otf" />
    <EmbeddedResource Include="../../third_party/IPAmjMincho/ipamjm.ttf" LogicalName="ExcelRenderer.ipamjm.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="PDFsharp" Version="6.2.3" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.0" />
  </ItemGroup>
</Project>
