<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCoreBuildOutput</TargetsForTfmSpecificBuildOutput>

    <Version>1.11.0</Version>
    <PackageId>ExcelRenderer</PackageId>
    <Title>ExcelRenderer</Title>
    <Description>Render Excel XLSX files to PDF, PostScript, PNG and SVG.</Description>
    <Authors>akrym1582</Authors>
    <PackageTags>excel xlsx pdf postscript png svg openxml skia</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/akrym1582/ExcelRenderer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

  </PropertyGroup>
  
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer.Core/ExcelRenderer.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
  </ItemGroup>
  <Target Name="IncludeCoreBuildOutput" DependsOnTargets="ResolveReferences">
    <!-- Bundle the verified library output independently of copy-local item
         enumeration. Missing required files must fail packing explicitly. -->
    <ItemGroup>
      <_RequiredCoreOutput Include="$(TargetDir)ExcelRenderer.Core.dll;$(TargetDir)ExcelRenderer.Core.xml" />
    </ItemGroup>
    <Error Condition="!Exists('%(_RequiredCoreOutput.Identity)')" Text="Required Core package output is missing: %(_RequiredCoreOutput.Identity). Build ExcelRenderer before packing." />
    <ItemGroup>
      <BuildOutputInPackage Include="@(_RequiredCoreOutput)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer.OpenXml/ExcelRenderer.OpenXml.csproj" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="../../build/EmbeddedOpenXml.targets" />
  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer.OpenXml.Reader/ExcelRenderer.OpenXml.Reader.csproj" PrivateAssets="all" />
    <ProjectReference Include="../ExcelRenderer.Formulas/ExcelRenderer.Formulas.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
