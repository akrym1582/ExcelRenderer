<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCoreBuildOutput</TargetsForTfmSpecificBuildOutput>

    <Version>1.10.0</Version>
    <PackageId>ExcelRenderer</PackageId>
    <Title>ExcelRenderer</Title>
    <Description>Render Excel XLSX files to PDF, PNG, SVG and AI-friendly Markdown.</Description>
    <Authors>akrym1582</Authors>
    <PackageTags>excel xlsx pdf png svg markdown openxml skia</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/akrym1582/ExcelRenderer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

  </PropertyGroup>
  
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer.Core/ExcelRenderer.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.0" />
  </ItemGroup>
  <Target Name="IncludeCoreBuildOutput" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'ExcelRenderer.Core' And '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->'%(RootDir)%(Directory)ExcelRenderer.Core.xml')" Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'ExcelRenderer.Core' And '%(ReferenceCopyLocalPaths.Extension)' == '.dll' And Exists('%(ReferenceCopyLocalPaths.RootDir)%(ReferenceCopyLocalPaths.Directory)ExcelRenderer.Core.xml')" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="../ExcelRenderer.OpenXml/ExcelRenderer.OpenXml.csproj" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="../../build/EmbeddedOpenXml.targets" />
</Project>
