<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefineConstants>$(DefineConstants);REFERENCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ExcelRenderer/ExcelRenderer.csproj" />
    <Compile Include="../ExcelRenderer.Core.Validation/Program.cs" Link="Program.cs" />
    <Compile Include="../ExcelRenderer.Core.Validation/InterlockedExtensions.cs" Link="InterlockedExtensions.cs" />
  </ItemGroup>
</Project>
