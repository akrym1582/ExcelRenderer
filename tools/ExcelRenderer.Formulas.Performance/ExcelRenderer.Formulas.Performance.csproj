<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">../..</RepositoryRoot>
    <DefineConstants Condition="'$(Baseline)' == 'true'">$(DefineConstants);BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepositoryRoot)/src/ExcelRenderer/ExcelRenderer.csproj" />
    <ProjectReference Include="$(RepositoryRoot)/src/ExcelRenderer.Mapping/ExcelRenderer.Mapping.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Baseline)' == 'true'">
    <Compile Remove="EngineBenchmark.cs" />
  </ItemGroup>
</Project>
